
<!DOCTYPE html>
<html>
<head>
    <title>Sweet Delights Bakery</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #fff8f0;
            color: #493126;
        }

        /* Navigation */
        nav {
            background: #713f35;
            color: white;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h1 {
            color: #ffdfb8;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 10px;
        }

        /* Banner */
        .banner {
            background: linear-gradient(
                rgba(70, 35, 25, 0.55),
                rgba(70, 35, 25, 0.55)
            ),
            url("https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=1200");

            background-size: cover;
            background-position: center;
            color: white;
            text-align: center;
            padding: 100px 20px;
        }

        .banner h2 {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .banner p {
            font-size: 20px;
        }

        .banner button {
            background: #f5c58b;
            color: #493126;
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
            margin-top: 20px;
            cursor: pointer;
        }

        /* Sections */
        .section {
            padding: 45px 25px;
            text-align: center;
        }

        .section h2 {
            color: #713f35;
            margin-bottom: 25px;
            font-size: 30px;
        }

        /* Products */
        .products {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
        }

        .card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 10px #d9c5b8;
            padding-bottom: 20px;
        }

        .card img {
            width: 100%;
            height: 190px;
            object-fit: cover;
        }

        .card h3 {
            margin: 12px;
            color: #713f35;
        }

        .card p {
            margin: 8px;
        }

        .price {
            color: #b35b42;
            font-weight: bold;
            font-size: 20px;
        }

        .card button {
            background: #713f35;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }

        .card button:hover {
            background: #a75e4c;
        }

        /* Seasonal Offers */
        .offers {
            background: #f4d8bd;
            padding: 45px 20px;
            text-align: center;
        }

        .offers h2 {
            color: #713f35;
            font-size: 30px;
        }

        .offers p {
            margin-top: 15px;
            font-size: 20px;
        }

        /* Custom Cakes */
        .custom {
            background: #fff0e2;
            padding: 40px 20px;
            text-align: center;
        }

        .custom img {
            width: 100%;
            max-width: 350px;
            height: 230px;
            object-fit: cover;
            border-radius: 12px;
            margin: 20px;
        }

        /* Gallery */
        .gallery {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
        }

        .gallery img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
        }

        /* Contact */
        .contact {
            background: #713f35;
            color: white;
            text-align: center;
            padding: 40px 20px;
        }

        .contact h2 {
            color: #ffdfb8;
            margin-bottom: 20px;
        }

        .contact p {
            margin: 12px;
        }

        footer {
            background: #40251f;
            color: white;
            text-align: center;
            padding: 15px;
        }

        @media(max-width: 600px) {
            nav {
                flex-direction: column;
                gap: 12px;
            }

            .banner h2 {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav>
        <h1>Sweet Delights 🍰</h1>

        <div>
            <a href="#">Home</a>
            <a href="#products">Menu</a>
            <a href="#custom">Custom Cakes</a>
            <a href="#gallery">Gallery</a>
            <a href="#contact">Contact</a>
        </div>
    </nav>

    <!-- Home Banner -->
    <section class="banner">
        <h2>Welcome to Sweet Delights Bakery</h2>

        <p>Freshly Baked Happiness in Every Bite!</p>

        <button onclick="location.href='#products'">
            Explore Our Menu
        </button>
    </section>

    <!-- Products -->
    <section class="section" id="products">

        <h2>Our Bakery Products</h2>

        <div class="products">

            <div class="card">
                <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=500"
                     alt="Chocolate Cake">

                <h3>Chocolate Cake</h3>
                <p>Rich and delicious chocolate cake.</p>
                <p class="price">₹650</p>

                <button onclick="order('Chocolate Cake')">
                    Order Now
                </button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1488477181946-6428a0291777?w=500"
                     alt="Pastry">

                <h3>Fresh Pastry</h3>
                <p>Soft and creamy fresh pastry.</p>
                <p class="price">₹80</p>

                <button onclick="order('Fresh Pastry')">
                    Order Now
                </button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1499636136210-6f4ee915583e?w=500"
                     alt="Cookies">

                <h3>Chocolate Cookies</h3>
                <p>Crispy and tasty chocolate cookies.</p>
                <p class="price">₹150</p>

                <button onclick="order('Chocolate Cookies')">
                    Order Now
                </button>
            </div>

            <div class="card">
                <img src="https://images.unsplash.com/photo-1558301211-0d8c8ddee6ec?w=500"
                     alt="Cupcakes">

                <h3>Vanilla Cupcakes</h3>
                <p>Soft vanilla cupcakes with cream.</p>
                <p class="price">₹60</p>

                <button onclick="order('Vanilla Cupcakes')">
                    Order Now
                </button>
            </div>

        </div>
    </section>

    <!-- Seasonal Offers -->
    <section class="offers">
        <h2>🎉 Special Seasonal Offers 🎉</h2>

        <p>Enjoy 20% OFF on all cakes!</p>

        <p>Buy 5 Cookies and Get 1 Free!</p>

        <p>Celebrate Every Moment with Sweet Delights!</p>
    </section>

    <!-- Custom Cake Designs -->
    <section class="custom" id="custom">

        <h2>Custom Cake Designs</h2>

        <p>
            Make your special occasions memorable
            with our beautiful customized cakes.
        </p>

        <img src="https://images.unsplash.com/photo-1535254973040-607b474cb50d?w=600"
             alt="Custom Birthday Cake">

        <img src="https://images.unsplash.com/photo-1464349095431-e9a21285b5f3?w=600"
             alt="Special Celebration Cake">

        <p>Birthday Cakes | Wedding Cakes | Anniversary Cakes</p>

        <button onclick="alert('Please contact us to customize your cake!')">
            Customize Your Cake
        </button>

    </section>

    <!-- Image Gallery -->
    <section class="section" id="gallery">

        <h2>Our Bakery Gallery</h2>

        <div class="gallery">

            <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=400"
                 alt="Chocolate Cake">

            <img src="https://images.unsplash.com/photo-1488477181946-6428a0291777?w=400"
                 alt="Pastry">

            <img src="https://images.unsplash.com/photo-1499636136210-6f4ee915583e?w=400"
                 alt="Cookies">

            <img src="https://images.unsplash.com/photo-1558301211-0d8c8ddee6ec?w=400"
                 alt="Cupcakes">

        </div>
    </section>

    <!-- Contact Details -->
    <section class="contact" id="contact">

        <h2>Contact Us</h2>

        <p>📍 Address: Main Road, Hyderabad, Telangana</p>

        <p>📞 Phone: +91 98765 43210</p>

        <p>✉ Email: sweetdelights@gmail.com</p>

        <p>🕒 Opening Hours: 9:00 AM - 9:00 PM</p>

    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 Sweet Delights Bakery</p>
        <p>Made with Love ❤️</p>
    </footer>

    <script>
        function order(product) {
            alert("Thank you for choosing " +
                  product + "! Please contact our bakery to order.");
        }
    </script>

</body>
</html>
